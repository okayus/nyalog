{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote -v:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(curl -s https://api.github.com/*)",
      "Bash(curl -s https://nyalog.shiraoka.workers.dev/*)",
      "Bash(docker compose exec -T dev *)",
      "Bash(docker compose exec dev *)",
      "Bash(scripts/ci-status.sh:*)",
      "Bash(./scripts/ci-status.sh:*)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_close",
      "WebFetch(domain:nyalog.shiraoka.workers.dev)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.mcp.cloudflare.com)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "sandboxed-agent-github-token-via-1password": "name-only",
    "cloudflare-d1-weekly-backup-via-pr": "name-only",
    "cloudflare-api-token-permissions": "name-only",
    "cloudflare-workers-deploy-skeleton": "name-only",
    "cloudflare-cron-to-discord": "name-only",
    "cloudflare-workers-host-synthetic-check": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-container.py",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-relay-merge.py",
            "args": [],
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-frontend.sh",
            "args": [],
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-frontend.sh",
            "args": [],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
