{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/okayus/nyalog/main/docs/senders/tasks-due-response.schema.json",
  "title": "GET /api/tasks/due?from&to の応答",
  "description": "期間内の予定日を (task × cat × dueDate) ごとに 1 要素で。dueDate、taskId、catId の順",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "format": "uuid",
        "description": "タスクの UUID"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "description": "タスク名"
      },
      "catId": {
        "type": "string",
        "format": "uuid",
        "description": "猫の UUID"
      },
      "catName": {
        "type": "string",
        "minLength": 1,
        "description": "猫の表示名 (nyalog 側)"
      },
      "dueDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "予定日 (YYYY-MM-DD)",
        "format": "date"
      },
      "completed": {
        "type": "boolean",
        "description": "その日・その猫について完了済みか"
      }
    },
    "required": [
      "taskId",
      "title",
      "catId",
      "catName",
      "dueDate",
      "completed"
    ],
    "additionalProperties": false
  }
}
