# WebAuthn / session settings (see ADR-003)
# SESSION_SECRET: random 32+ byte secret for hono/jwt HS256 + challenge cookie
# Generate with: openssl rand -hex 32
SESSION_SECRET=<random-hex-string>

# INITIAL_REGISTRATION_TOKEN: short-lived token for bootstrapping the first user.
# Unset in production once onboarding is complete.
INITIAL_REGISTRATION_TOKEN=<random-token-or-leave-unset>

# DEV_BYPASS_USER_ID (dev only): if set AND ORIGIN is a localhost URL,
# sessionMiddleware skips passkey auth and injects this UUID as the logged-in
# user. Both must be set together; DEV_BYPASS_USER_ID alone is ignored for
# safety because wrangler.jsonc defaults ORIGIN to the production URL.
# Never set either in a production secret. See docs/local-dev.md for details.
# DEV_BYPASS_USER_ID=00000000-0000-4000-8000-000000000000
# ORIGIN=http://localhost:5173

# PAT_PEPPER: mixed into personal access token hashes, sha256(token + PAT_PEPPER) (ADR-009).
# Production: `openssl rand -hex 32 | wrangler secret put PAT_PEPPER`, BEFORE minting the first
# token (setting it later invalidates every token minted without it). Local dev may leave it
# unset; the Worker refuses to mint only when ORIGIN is not localhost.
PAT_PEPPER=
